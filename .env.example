# Pulse Environment Configuration

# Application
PULSE_ENV=development
PULSE_DEBUG=true
PULSE_SECRET_KEY=change-me-in-production
PULSE_API_HOST=0.0.0.0
PULSE_API_PORT=8000
PULSE_LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
# Privileged connection used for pre-authentication lookups (login, registration).
# Once RLS is enforced with a dedicated scoped app role (see BUILD_REPORT H-1),
# DATABASE_URL points at that role and this must point at an admin role that can
# read users before a workspace context exists. Leave empty to fall back to
# DATABASE_URL (single-role development setups).
DATABASE_ADMIN_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limiting (fixed 60-second windows per client IP, applied to the
# anonymous auth endpoints; counters live in Redis when reachable).
# 0 disables the individual limiter; RATE_LIMIT_ENABLED=false disables all.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3

# Object Storage (S3/MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=pulse
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Vault integration
VAULT_API_URL=http://localhost:8001
VAULT_API_KEY=

# LLM Providers (provide at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001

# Analytics (optional)
SEGMENT_WRITE_KEY=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
MIXPANEL_PROJECT_TOKEN=

# Webhooks
WEBHOOK_SIGNING_SECRET=whsec_change_me
